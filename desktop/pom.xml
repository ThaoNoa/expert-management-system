<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Dùng chung quản lý version (Jackson, JUnit, plugin) với backend; KHÔNG dùng Spring trong app desktop. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.npcore</groupId>
    <artifactId>ems-desktop</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>EMS - Expert Management System (desktop)</name>

    <properties>
        <java.version>21</java.version>
        <javafx.version>21.0.5</javafx.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <main.class>com.npcore.ems.desktop.Launcher</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ems-desktop</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- target/lib: toàn bộ thư viện (kể cả JavaFX bản Windows) → đầu vào cho jpackage -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-libs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Mặc định: JavaFX 21 từ Maven Central (tự chọn bản Windows / Linux / macOS theo máy build). -->
        <profile>
            <id>javafx-maven</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                </dependency>
            </dependencies>
        </profile>

        <!--
          offline: compile/kiểm tra khi không tới được Maven Central, dùng JavaFX cài sẵn trên máy
          (VD Ubuntu: apt install openjfx → /usr/share/openjfx/lib). mvn -o -Poffline verify
        -->
        <profile>
            <id>offline</id>
            <properties>
                <javafx.offline.dir>/usr/share/openjfx/lib</javafx.offline.dir>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                    <version>offline</version>
                    <scope>system</scope>
                    <systemPath>${javafx.offline.dir}/javafx.base.jar</systemPath>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>offline</version>
                    <scope>system</scope>
                    <systemPath>${javafx.offline.dir}/javafx.graphics.jar</systemPath>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>offline</version>
                    <scope>system</scope>
                    <systemPath>${javafx.offline.dir}/javafx.controls.jar</systemPath>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
